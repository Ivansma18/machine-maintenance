generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MachineStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  RETIRED
}

enum MachineCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
}

enum MaintenanceResult {
  OK
  NEEDS_FOLLOW_UP
  FAILED
  CRITICAL_FAILURE
}

enum NotificationType {
  PREVENTIVE_DUE_SOON
  PREVENTIVE_OVERDUE
  URGENT_CRITICAL_FAILURE
}

enum NotificationSeverity {
  INFO
  WARNING
  URGENT
  CRITICAL
}

enum NotificationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model MachineCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  machines    Machine[]
}

model Machine {
  id           String             @id @default(uuid()) @db.Uuid
  categoryId   String             @db.Uuid
  name         String             @db.VarChar(150)
  serialNumber String?            @unique @db.VarChar(100)
  location     String             @db.VarChar(150)
  manufacturer String?            @db.VarChar(100)
  model        String?            @db.VarChar(100)
  status       MachineStatus      @default(ACTIVE)
  criticality  MachineCriticality @default(MEDIUM)
  installedAt  DateTime?          @db.Date
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  category         MachineCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  maintenancePlans MaintenancePlan[]
  maintenanceLogs  MaintenanceLog[]
  notifications    Notification[]

  @@index([categoryId])
  @@index([status])
  @@index([criticality])
  @@index([location])
}

model MaintenancePlan {
  id                String    @id @default(uuid()) @db.Uuid
  machineId         String    @db.Uuid
  name              String    @db.VarChar(150)
  description       String?   @db.Text
  frequencyDays     Int
  warningDaysBefore Int       @default(7)
  isActive          Boolean   @default(true)
  startsAt          DateTime  @db.Date
  lastComputedDueAt DateTime? @db.Date
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  machine         Machine          @relation(fields: [machineId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  maintenanceLogs MaintenanceLog[]
  notifications   Notification[]

  @@index([machineId])
  @@index([isActive, lastComputedDueAt])
  @@index([startsAt])
}

model MaintenanceLog {
  id                String            @id @default(uuid()) @db.Uuid
  machineId         String            @db.Uuid
  maintenancePlanId String?           @db.Uuid
  performedAt       DateTime          @db.Timestamptz(3)
  type              MaintenanceType
  result            MaintenanceResult
  notes             String?           @db.Text
  performedBy       String            @db.VarChar(150)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  machine         Machine          @relation(fields: [machineId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  maintenancePlan MaintenancePlan? @relation(fields: [maintenancePlanId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([machineId, performedAt])
  @@index([maintenancePlanId, performedAt])
  @@index([type, result])
}

model Notification {
  id                String               @id @default(uuid()) @db.Uuid
  machineId         String               @db.Uuid
  maintenancePlanId String?              @db.Uuid
  type              NotificationType
  severity          NotificationSeverity
  status            NotificationStatus   @default(OPEN)
  title             String               @db.VarChar(180)
  message           String               @db.Text
  dueAt             DateTime?            @db.Timestamptz(3)
  resolvedAt        DateTime?            @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)

  machine         Machine          @relation(fields: [machineId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  maintenancePlan MaintenancePlan? @relation(fields: [maintenancePlanId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([machineId, status])
  @@index([maintenancePlanId, type, status])
  @@index([status, severity])
  @@index([dueAt])
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  name         String   @db.VarChar(150)
  passwordHash String   @db.VarChar(255)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  roles    UserRole[]
  sessions Session[]
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  roles RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(128)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}
